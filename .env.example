# Din bots token från https://discord.com/developers/applications (Bot -> Reset Token)
DISCORD_TOKEN=

# Hur ofta panelerna uppdateras, i minuter. Sker på jämna klockslag (:00, :15, :30, :45).
# Måste gå jämnt upp i 60: 5, 10, 15, 20, 30 eller 60.
UPDATE_MINUTES=15

# Namn som skickas till texttv.nu så att de vet vem som anropar
TEXTTV_APP_NAME=discord-texttv-bot
